{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!test/fixtures/*.json", "!vendor"]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [{ "group": ["@arcue/*"], "message": "The public Blender reader imports nothing from Arcue." }]
          }
        }
      }
    }
  }
}
