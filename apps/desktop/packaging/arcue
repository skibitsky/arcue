#!/bin/sh
# The arcue command of an installed Arcue app. Runs the command line in the app on the app's own Electron as Node.
# It is Contents/Resources/bin/arcue in Arcue.app and bin/arcue in the Linux app, usually reached through a symlink.

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

user_path=$PATH
safe_path=''
rest=$PATH:
while [ -n "$rest" ]; do
  dir=${rest%%:*}
  rest=${rest#*:}
  case $dir in /*) safe_path=$safe_path${safe_path:+:}$dir ;; esac
done
PATH=$safe_path
export PATH

self=$0
for _ in 1 2 3 4 5 6 7 8; do
  [ -L "$self" ] || break
  link=$(readlink -- "$self") || break
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
here=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd -P) || die "Cannot find the folder of $0."

if [ -f "$here/../../MacOS/Arcue" ]; then
  root=$(CDPATH='' cd -- "$here/../.." && pwd -P) || die "Cannot find the app that holds $here."
  app=$root/MacOS/Arcue
  script=$root/Resources/cli/arcue.js
else
  root=$(CDPATH='' cd -- "$here/.." && pwd -P) || die "Cannot find the app that holds $here."
  app=$root/Arcue
  script=$root/resources/cli/arcue.js
fi
{ [ -f "$app" ] && [ -x "$app" ] && [ -f "$script" ]; } || die "Reinstall Arcue: $root is not a complete Arcue app."

PATH=$user_path
export PATH
unset NODE_OPTIONS
ELECTRON_RUN_AS_NODE=1 exec "$app" "$script" "$@"
