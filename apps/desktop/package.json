{
  "name": "@arcue/desktop",
  "productName": "Arcue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json",
    "test:e2e": "pnpm --filter @arcue/cli build && node scripts/build.ts && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@arcue/core": "workspace:*",
    "@arcue/import-fbx": "workspace:*",
    "@arcue/protocol": "workspace:*",
    "@arcue/scene": "workspace:*",
    "@arcue/ui": "workspace:*",
    "@arcue/viewport": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "catalog:",
    "playwright": "1.63.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
